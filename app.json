{
  "expo": {
    "name": "Ébresztő",
    "slug": "ebreszto",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "ebreszto",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "hu.astron.ebreszto"
    },
    "android": {
      "package": "hu.astron.ebreszto"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ébresztőhöz fotó kiválasztásához szükséges.",
          "cameraPermission": "Fénykép készítéséhez szükséges."
        }
      ]
    ]
  }
}
